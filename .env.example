# =============================================================================
# WOMUP Environment Configuration Template
# =============================================================================
# IMPORTANT SECURITY NOTICE:
# - Variables prefixed with VITE_ are exposed to the client-side browser bundle.
# - NEVER put database credentials, secret keys, or private API keys in VITE_ variables!
# - Backend and database configurations must ONLY be kept in a secure server-side
#   environment (e.g., Node.js, Next.js server, or cloud secret manager).
# =============================================================================

# -----------------------------------------------------------------------------
# 1. FRONTEND / CLIENT CONFIGURATION (Safe for browser bundle)
# -----------------------------------------------------------------------------
# Base URL for the WOMUP Backend REST API
# In production, use your actual domain (e.g. https://api.womup.in/api/v1)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Enable mock services fallback.
# Set to 'true' to use rich demonstration datasets without requiring a running backend.
# Set to 'false' to route all service requests to the real backend API.
VITE_USE_MOCK_API=true

# Local storage key names for auth tokens
VITE_AUTH_TOKEN_KEY=womup_auth_token
VITE_REFRESH_TOKEN_KEY=womup_refresh_token

# Application branding and support contact
VITE_APP_NAME=WOMUP
VITE_SUPPORT_EMAIL=support@womup.in
VITE_SUPPORT_PHONE=+919876543210

# -----------------------------------------------------------------------------
# 2. BACKEND / SERVER CONFIGURATION (SERVER-SIDE ONLY — DO NOT EXPOSE TO CLIENT)
# -----------------------------------------------------------------------------
# Server port & environment
PORT=8000
NODE_ENV=development

# -----------------------------------------------------------------------------
# 3. DATABASE CONFIGURATION (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
# PostgreSQL / Supabase / MongoDB connection string
# Example PostgreSQL URL: postgresql://username:password@localhost:5432/womup_db?sslmode=prefer
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/womup_db

# Connection Pool Settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# -----------------------------------------------------------------------------
# 4. AUTHENTICATION & JWT CONFIGURATION (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
# Generate a secure 256-bit secret using: openssl rand -base64 32
JWT_ACCESS_SECRET=replace_with_a_secure_random_256bit_secret_key
JWT_REFRESH_SECRET=replace_with_another_secure_random_256bit_secret_key
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing cost factor
BCRYPT_SALT_ROUNDS=12

# -----------------------------------------------------------------------------
# 5. THIRD-PARTY NOTIFICATIONS / SMS GATEWAY (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
# SMS OTP Gateway configuration (e.g. Fast2SMS, MSG91)
# SMS_GATEWAY_API_KEY=
# SMS_SENDER_ID=WOMUP

# WhatsApp Business Cloud API (For verified transactional notifications)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
